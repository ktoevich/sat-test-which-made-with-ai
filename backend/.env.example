# Copy to .env and adjust as needed. Values below are the defaults.

# development | production | testing
FLASK_ENV=development

# Where wsgi.py binds when run directly.
HOST=127.0.0.1
PORT=5000

# Absolute or relative path to the generated test bundles.
# QUESTION_BANK_PATH=data/tests_bundle_cache.json

# SQLite file holding accounts, sessions and test history.
# DATABASE_PATH=data/app.db

# PBKDF2 rounds for password hashing. Raise as hardware gets faster.
# PASSWORD_ITERATIONS=600000

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=*

# Set to 0 to run the API without serving ../frontend.
SERVE_FRONTEND=1
