# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Local database (accounts and test history)
backend/data/app.db
backend/data/app.db-wal
backend/data/app.db-shm

# Generated answer keys (never publish)
answer-keys/

# The question bank. It is built locally — from the templates, or from a
# third-party export — and reaches a deployment through `app.cli bank push`
# rather than through the repository.
backend/data/tests_bundle_cache.json

# Local copy of College Board's question bank: third-party content, and the
# raw dump is tens of megabytes. The downloaded data stays out of the
# repository; the tools that rebuild it are ours, so they stay in — the README
# tells a fresh clone to run them.
question-bank/*
!question-bank/tools/
!question-bank/README.md
question-bank/tools/__pycache__/

# The standalone test's questions are built from that same bank.
standalone-test/questions.js

# Environment
.env
.env.local

# Logs
*.log

# Node (test tooling only; the app itself needs no build)
node_modules/

# Editors / OS
.DS_Store
.idea/
.vscode/
.cph/
